# ===== Chat API（科大 LLM 代理）=====
OPENAI_API_KEY="sk-xxx"
OPENAI_BASE_URL="https://api.llm.ustc.edu.cn/v1"

# 对话模型（可选，不设则用 deepseek-v4-flash-ascend；慢时可换 qwen-chat / qwen3.6-chat）
# CHAT_MODEL="qwen-chat"

# ===== Embedding API（硅基流动）=====
EMBEDDING_API_KEY="sk-xxx"
EMBEDDING_BASE_URL="https://api.siliconflow.cn/v1"

# ===== Supabase（主检索后端，pgvector）=====
SUPABASE_URL="https://xxx.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_xxx"
SUPABASE_SERVICE_ROLE_KEY="eyJxxx（仅服务端脚本使用，勿提交到前端）"

# ===== Dify（兜底检索后端，5 个主题知识库）=====
# 留空则使用 app/lib/retrieval/dify.ts 中内置的默认 key 与数据集 ID
# DIFY_API_KEY="dataset-xxx"

# ===== Tavily（第三层兜底：官网实时搜索）=====
# 可选。不配置时 Supabase/Dify 都无命中的问题会直接回复"暂无相关信息"
# TAVILY_API_KEY="tvly-xxx"
