# ===== Chat API（科大 LLM 代理）=====
OPENAI_API_KEY="sk-xxx"
OPENAI_BASE_URL="https://api.llm.ustc.edu.cn/v1"
# 对话模型（可选，不设则用 deepseek-v4-flash-ascend；慢时可换 qwen-chat / qwen3.6-chat）
# CHAT_MODEL="qwen-chat"

# ===== Embedding API（硅基流动，仅脚本使用）=====
EMBEDDING_API_KEY="sk-xxx"
EMBEDDING_BASE_URL="https://api.siliconflow.cn/v1"

# ===== Dify 知识库检索（自建 Dify）=====
# Dify 服务地址，结尾不带 /v1，例如 http://111.111.111.111
DIFY_BASE_URL=""
# Dify「知识库」API Key（在 Dify 后台：知识库 → API 处创建，注意不是应用 app-xxx Key）
DIFY_KNOWLEDGE_API_KEY=""
# 知识库 Dataset ID 列表，多个用英文逗号分隔，例如 "a1b2c3,d4e5f6"。ID看浏览器地址栏 /datasets/{一大串ID}/documents
DATASET_IDS=""
# 可选：覆盖 Dify 后台默认检索参数（不设置则使用 Dify 默认配置）
# DIFY_RETRIEVAL_TOP_K="5"
# DIFY_RETRIEVAL_SCORE_THRESHOLD="0.5"

