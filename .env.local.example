# ===== Chat API（OpenAI 兼容接口；默认 DeepSeek）=====
OPENAI_API_KEY="sk-xxx"
OPENAI_BASE_URL="https://api.deepseek.com"
# 对话模型（可选，不设则用 deepseek-v4-flash）
# CHAT_MODEL="deepseek-v4-flash"
# 送入模型的最近消息条数（默认 24，范围 6–50；浏览器仍保留完整记录）
# CHAT_HISTORY_MESSAGES="24"
# 可选：配置不同的备用模型后，仅在主模型网络/超时失败时降级
# CHAT_FALLBACK_MODEL=""

# ===== 登录、会话与个人模型配置 =====
# 首位用户始终可以创建账号；是否允许后续用户自助注册
# AUTH_ALLOW_REGISTRATION="false"
# 生产或多实例部署必须显式设置固定随机值；本地单实例缺省时会生成到 data/auth/.secrets.json
# AUTH_SESSION_SECRET="replace-with-a-long-random-secret"
# AUTH_ENCRYPTION_KEY="replace-with-another-long-random-secret"
# 可选：认证数据目录；默认 data/auth（已 gitignore）
# AUTH_DATA_DIR="C:\\secure-data\\campus-ai-auth"
# 可选：仅在代理协议识别不准确时手工指定 Cookie 是否必须 HTTPS
# AUTH_COOKIE_SECURE="true"
# 允许用户使用的内网/HTTP 模型 API Origin，多个用英文逗号分隔；默认只允许公网 HTTPS
# MODEL_BASE_URL_ALLOWLIST="https://gateway.example.edu.cn"

# ===== API 基础防护 =====
# 反向代理或跨域前端的可信来源，多个用英文逗号分隔；同源访问无需配置
# APP_ALLOWED_ORIGINS="https://campus.example.edu.cn"
# 只有请求一定经过会覆盖 X-Forwarded-* 的可信反向代理时才开启
# TRUST_PROXY_HEADERS="false"
# 固定窗口限流；以下是默认值，可按部署规模调整
# API_RATE_LIMIT_WINDOW_MS="300000"
# API_RATE_LIMIT_CHAT="40"
# API_RATE_LIMIT_EXPORT="20"
# API_RATE_LIMIT_SUMMARIZE="80"
# API_RATE_LIMIT_AUTH="10"
# API_RATE_LIMIT_MODELCONFIG="30"

# ===== Embedding API（硅基流动，仅脚本使用）=====
EMBEDDING_API_KEY="sk-xxx"
EMBEDDING_BASE_URL="https://api.siliconflow.cn/v1"

# ===== Dify 知识库检索（自建 Dify）=====
# Dify 服务地址，结尾不带 /v1，例如 http://111.111.111.111
DIFY_BASE_URL=""
# Dify「知识库」API Key（在 Dify 后台：知识库 → API 处创建，注意不是应用 app-xxx Key）
DIFY_KNOWLEDGE_API_KEY=""
# 知识库 Dataset ID 列表，多个用英文逗号分隔，例如 "a1b2c3,d4e5f6"。ID看浏览器地址栏 /datasets/{一大串ID}/documents
DATASET_IDS=""
# 可选：覆盖数据集路由。JSON 的键可用 scholarships/library/notices/shuttle/calendar/courses/policies/info，值为 Dataset ID 数组。
# 未设置时，本项目内置的 8 个数据集 ID 会自动按主题路由；使用其他数据集时建议配置。
# DIFY_DATASET_ROUTE_MAP='{"calendar":["dataset-id"],"shuttle":["dataset-id"]}'
# 可选：覆盖代码默认检索参数（默认 semantic + bge reranker + top_k=5 + 无阈值）
# DIFY_RETRIEVAL_TOP_K="5"
# 可选：强制统一检索方式；不设置时普通问题使用 semantic，精确课程号使用 hybrid + top_k=10
# DIFY_RETRIEVAL_SEARCH_METHOD=""
# DIFY_MAX_CONTEXT_CHUNKS="12"
# DIFY_RERANKING_ENABLED="true"
# DIFY_RERANKING_PROVIDER="langgenius/siliconflow/siliconflow"
# DIFY_RERANKING_MODEL="BAAI/bge-reranker-v2-m3"
# 不建议跨库使用统一阈值；确有需要时再设置
# DIFY_RETRIEVAL_SCORE_THRESHOLD=""
# 可选：按 Dataset ID 设置独立最低分数，适合各库分数分布不同的情况
# DIFY_DATASET_SCORE_THRESHOLDS='{"dataset-id-a":0.55,"dataset-id-b":0.35}'

# ===== Dify 联网搜索工作流 =====
# 在 Dify 应用的 API 访问页面创建（app- 开头）
DIFY_WORKFLOW_API_KEY=""
# 可选：额外屏蔽的低质量或风险域名，英文逗号分隔
# DIFY_SEARCH_BLOCKED_DOMAINS="example-spam.com,example-ads.com"

# ===== 蜗壳排课知识同步（可选）=====
# scripts/sync-wokepaike-dify.mjs 的目标知识库；未设置时使用项目内置“学校课程”数据集 ID
# WOKEPAIKE_DIFY_DATASET_ID="dataset-id"

# ===== Agent 本地能力（可选，服务端安全边界）=====
# 全局硬边界；必须显式配置，留空时 Agent 默认拒绝访问所有目录
# AGENT_ALLOWED_ROOTS="C:\\Users\\your-name\\Documents;C:\\Users\\your-name\\Projects"
# 多用户部署必须按用户名或用户 ID 分配根目录；单用户本地部署可省略
# AGENT_USER_ROOTS_JSON={"alice":["C:\\Users\\alice\\Projects"]}
# 不建议开启；仅在所有账号都可信且确实需要共享全局根目录时使用
AGENT_ALLOW_SHARED_ROOTS="false"
# 本地内容默认逐次批准后才发送给当前模型 API
AGENT_REQUIRE_READ_APPROVAL="true"
# 命令执行默认关闭；开启后仍需匹配程序 + 参数规则并由用户逐次批准
AGENT_ENABLE_COMMAND_EXECUTION="false"
# 推荐的新规则格式；以下示例只允许 git status 及其附加参数
# AGENT_COMMAND_RULES_JSON=[{"executable":"C:\\Program Files\\Git\\cmd\\git.exe","argsPrefix":["status"],"allowAdditionalArgs":true}]
# 旧版白名单仅兼容无参数、--version、-v、version、--help 调用
# AGENT_ALLOWED_COMMANDS="C:\\Program Files\\nodejs\\node.exe,C:\\Program Files\\Git\\cmd\\git.exe"
# 子进程默认只获得最小系统环境；额外变量必须显式列出，切勿加入 API Key
# AGENT_COMMAND_ENV_ALLOWLIST=""
AGENT_MAX_CONCURRENT_COMMANDS_PER_USER="1"
# 可选；未配置时从持久化的 AUTH_SESSION_SECRET 派生
# TOOL_APPROVAL_SECRET="replace-with-a-long-random-secret"

